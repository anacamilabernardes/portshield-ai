include README.md README.pt-BR.md LICENSE DISCLAIMER.md SECURITY.md CONTRIBUTING.md CHANGELOG.md
recursive-include docs *.md
recursive-include configs *.json
recursive-include data *.json *.jsonl *.md
recursive-include notebooks *.ipynb
recursive-include docker Dockerfile *.yml
recursive-include deploy *.yaml
recursive-include monitoring *.yml *.md
recursive-include scripts *.py
recursive-include experiments *.py
recursive-include results *.json *.md
prune data/public/imported
prune results/runs
global-exclude __pycache__ *.pyc
